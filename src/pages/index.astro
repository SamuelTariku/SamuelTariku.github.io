---
const skills = [
	{ title: 'Languages', items: 'Go · TypeScript · Python · SQL · Dart' },
	{ title: 'Frontend', items: 'React · Next.js · Vue.js · Flutter' },
	{ title: 'Backend', items: 'Go / Fiber · Express · Django · Flask' },
	{ title: 'Data & tools', items: 'PostgreSQL · SQLite · MongoDB · Redis · Postman' },
];

const projects = [
	{ title: 'Multi-tenant sports betting platform', description: 'Customer apps, operations dashboards, wallets, and real-time betting systems.', tags: ['Next.js', 'Go / Fiber', 'PostgreSQL', 'Redis'], highlights: ['Tenant isolation, branding, and market configuration', 'Customer sportsbook, live odds, and bet slips', 'Admin dashboards, role-based access, and approval flows', 'Wallets, deposits, withdrawals, and payment integrations', 'WebSockets, notifications, and production support'] },
	{ title: 'Study abroad mobile application', description: 'Flutter app for students applying to universities abroad.', tags: ['Flutter', 'Product collaboration'] },
	{ title: 'Audiobook platform', description: 'Authentication, content management, and audio streaming.', tags: ['Express.js', 'Vue.js', 'Google Cloud'] },
	{ title: 'Supermarket e-commerce', role: 'Lead Frontend Developer', description: 'Admin tools and customer storefront for online shopping.', tags: ['Vue.js', 'E-commerce'] },
];
