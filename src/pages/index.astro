---
const skills = [
	{ title: 'Languages', items: 'Go · TypeScript · Python · SQL · Dart' },
	{ title: 'Frontend', items: 'React · Next.js · Vue.js · Flutter' },
	{ title: 'Backend', items: 'Go / Fiber · Express · Django · Flask' },
	{ title: 'Data & tools', items: 'PostgreSQL · SQLite · MongoDB · Redis · Postman' },
];

const projects = [
	{ title: 'Multi-tenant sports betting platform', description: 'Led development of a multi-tenant betting platform spanning customer apps, operational dashboards, and financial workflows.', detail: 'Designed tenant isolation around middleware and company context, with configurable branding and market settings. Built services in Go and Fiber, REST APIs, role-based access, wallets, approval flows, and real-time updates.', tags: ['Next.js', 'Go / Fiber', 'PostgreSQL', 'MongoDB', 'Redis'], highlights: ['SSR customer betting app with live events, odds, and interactive bet slips', 'Admin dashboards with React, TypeScript, Vite, Ant Design, Redux, and React Query', 'Role-based access for super admins, admins, branch managers, cashiers, approvers, and customers', 'Tenant isolation, company context, tenant branding, and market-specific configuration', 'Wallets, deposits, withdrawals, regular and bonus balances, payment providers, crypto, and exchange rates', 'Sportsbook aggregation, virtual gaming, WebSockets, live wallet updates, and notifications', 'Telegram OTP, SMS and email delivery retries, and background processing', 'Docker Compose development stack with PostgreSQL, MongoDB, and Redis', 'Resolved production issues across integrations, databases, reverse proxies, CORS, and WebSockets'] },
	{ title: 'Study abroad mobile application', description: 'Helped build a Flutter app for students applying to universities abroad, working directly with clients to turn business needs into a usable product.', tags: ['Flutter', 'Product collaboration'] },
	{ title: 'Audiobook platform', description: 'Contributed authentication, content management, and audio streaming features, backed by Google Cloud services.', tags: ['Express.js', 'Vue.js', 'Google Cloud'] },
	{ title: 'Supermarket e-commerce', description: 'Built responsive admin and customer-facing storefronts for a supermarket e-commerce platform.', tags: ['Vue.js', 'E-commerce', 'Responsive UI'] },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Samuel Tariku is a software engineer building thoughtful web and mobile products in Addis Ababa, Ethiopia." />
		<meta name="theme-color" content="#080b0a" />
		<title>Samuel Tariku — Software Engineer</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="site-frame">
			<header class="topbar">
				<a class="wordmark" href="#top" aria-label="Samuel Tariku home"><img src="/images/samuel-mark.png" alt="" /><span>ST // FIELD OPERATIVE</span></a>
				<nav aria-label="Main navigation"><a href="#about">about</a><a href="#experience">work</a><a href="#skills">stack</a></nav>
				<a class="top-contact" href="mailto:samueltarikufantaye@gmail.com"><span class="live-dot"></span> available for work</a>
			</header>

			<main id="top">
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-copy">
						<p class="terminal-line"><span class="prompt">samuel@portfolio</span>:~$ <span class="command">whoami</span></p>
						<p class="eyebrow">SOFTWARE ENGINEER <span>//</span> ADDIS ABABA, ETHIOPIA</p>
						<h1 id="hero-title">I build<br />things for the<br /><span class="glitch" data-text="digital world.">digital world.</span></h1>
						<p class="hero-intro">Full-stack developer with 3+ years building production web and mobile apps. I turn complex systems into clear, reliable products.</p>
						<div class="hero-actions"><a class="button button-primary" href="mailto:samueltarikufantaye@gmail.com">INITIATE CONTACT <span>↗</span></a><a class="text-link" href="#experience">[ view_selected_work ]</a></div>
					</div>
					<div class="terminal-card" aria-label="Developer terminal">
						<div class="terminal-head"><div class="window-dots"><i></i><i></i><i></i></div><span>samuel@localhost: ~/profile</span><span class="terminal-lock">● SECURE</span></div>
						<div class="terminal-body">
							<p><span class="terminal-muted">01</span> <span class="prompt">$</span> cat profile.json</p>
							<div class="json-block"><span class="brace">&#123;</span>
								<div><span class="json-key">"name"</span>: <span class="json-value">"Samuel Tariku"</span>,</div>
								<div><span class="json-key">"role"</span>: <span class="json-value">"Software Engineer"</span>,</div>
								<div><span class="json-key">"experience"</span>: <span class="json-value">"3+ years"</span>,</div>
								<div><span class="json-key">"focus"</span>: [</div>
								<div class="indent"><span class="json-value">"full-stack"</span>,</div><div class="indent"><span class="json-value">"web + mobile"</span></div>
								<div>]</div><span class="brace">&#125;</span>
							</div>
							<p class="terminal-result"><span class="terminal-muted">02</span> <span class="prompt">$</span> <span class="cursor">▌</span></p>
							<div class="terminal-footer"><span><i class="live-dot"></i> SYSTEM ONLINE</span><span>9°01' N 38°45' E</span></div>
						</div>
						<div class="terminal-orbit orbit-a"></div><div class="terminal-orbit orbit-b"></div>
					</div>
					<div class="hero-meta"><span>ENGINEERING WITH INTENTION</span><span>SCROLL TO EXPLORE <b>↓</b></span></div>
				</section>

				<section class="about section-grid" id="about">
					<div class="section-label"><span>01</span> ABOUT_ME</div>
					<div class="about-content"><p class="section-kicker">// a little context</p><h2>Curious by nature.<br /><span>Engineer by craft.</span></h2><div class="about-bottom"><p>I’m a full-stack developer focused on building production web and mobile applications. From multi-tenant platforms to client-facing dashboards, I enjoy owning a feature end to end and making the details feel right.</p><p>I work across product and backend teams, bringing clarity to complex requirements and moving comfortably in fast-paced environments.</p></div></div>
				</section>

				<section class="experience section-grid" id="experience">
					<div class="section-label"><span>02</span> EXPERIENCE</div>
					<div class="experience-content"><p class="section-kicker">// professional_history</p>
						<div class="experience-heading"><div><p class="eyebrow">APR 2023 — SEP 2026</p><h2>Lead Frontend Developer</h2><p class="company">Yaltopia Software Technologies <span>· Addis Ababa</span></p></div></div>
						<p class="role-summary">Leading frontend development while contributing across the stack to platforms serving real customers and businesses.</p>
						<div class="work-list">{projects.map((project, index) => <article class="work-item"><span class="work-index">0{index + 1}</span><div><h3>{project.title}</h3><p>{project.description}</p>{project.detail && <p>{project.detail}</p>}{index === 0 && <figure class="project-shot"><img src="/images/makerbets-dashboard.png" alt="Maker Bets sports betting platform dashboard showing leagues, live betting content, and betting tools" loading="lazy" /><figcaption><span>EXHIBIT A // CUSTOMER BETTING INTERFACE</span><span>CLASSIFICATION: PUBLIC</span></figcaption></figure>}{project.highlights && <details class="mission-brief"><summary>OPEN TECHNICAL BRIEF <span>+9 FILES</span></summary><ul>{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul></details>}<div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></div><span class="work-arrow">↗</span></article>)}</div>
					</div>
				</section>

				<section class="skills section-grid" id="skills"><div class="section-label"><span>03</span> TOOLKIT</div><div class="skills-content"><p class="section-kicker">// modules_loaded</p><h2>Tools I reach for.</h2><div class="skills-grid">{skills.map((skill, index) => <div class="skill-card"><span class="skill-number">0{index + 1} //</span><h3>{skill.title}</h3><p>{skill.items}</p></div>)}</div></div></section>

				<section class="education section-grid"><div class="section-label"><span>04</span> EDUCATION</div><div class="education-content"><div><p class="section-kicker">// foundational_knowledge</p><p class="eyebrow">JAN 2018 — MAR 2023</p><h2>BSc in Information Technology</h2><p class="company">Addis Ababa Institute of Technology</p></div><p class="education-note">Mobile Development · Security · System Design<br />Web Development · Databases · Networks</p></div></section>

				<section class="contact" id="contact"><p class="section-kicker">// connection.open()</p><p class="eyebrow">HAVE A GOOD PROJECT IN MIND?</p><h2>Let’s build<br /><span>what’s next<span class="cursor">_</span></span></h2><a class="button button-primary" href="mailto:samueltarikufantaye@gmail.com">START A CONVERSATION <span>↗</span></a><div class="contact-code">01010011<br />01010100<br />01000101</div></section>
			</main>
			<footer><span>© 2026 Samuel Tariku</span><span>BUILT WITH <b>♥</b> &amp; A LOT OF COFFEE</span><div class="socials"><a href="mailto:samueltarikufantaye@gmail.com">EMAIL ↗</a><a href="https://www.linkedin.com/in/samuel-tariku-a7a389113/" target="_blank" rel="noreferrer">LINKEDIN ↗</a><a href="https://github.com/SamuelTariku/" target="_blank" rel="noreferrer">GITHUB ↗</a></div></footer>
		</div>
	</body>
</html>

<style>
	:root{font-family:'Space Grotesk',sans-serif;color:#e4efe8;background:#080b0a;font-synthesis:none;text-rendering:optimizeLegibility;--bg:#080b0a;--panel:#0d1310;--ink:#e4efe8;--muted:#89968d;--line:#26352c;--green:#b7ff4a;--cyan:#63f2d4;--pink:#ff4fa3;--mono:'DM Mono',monospace}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:radial-gradient(ellipse at 76% 9%,#13302055,transparent 34%),var(--bg);background-attachment:fixed}.site-frame{max-width:1440px;margin:0 auto;padding:0 7.1%;position:relative}.site-frame:before{position:fixed;inset:0;content:'';pointer-events:none;z-index:10;opacity:.12;background:repeating-linear-gradient(0deg,transparent 0 3px,#000 4px 5px)}a{color:inherit;text-decoration:none}.topbar{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);font-family:var(--mono);position:relative;z-index:2}.wordmark{font-size:23px;font-weight:700;letter-spacing:-2px;color:var(--ink)}.wordmark span{color:var(--green);animation:blink 1s steps(2,start) infinite}.topbar nav{display:flex;gap:38px}.topbar nav a,.top-contact{font-size:11px;color:#aab8ae;transition:color .2s}.topbar nav a:before{content:'./';color:var(--green);opacity:0;transition:opacity .2s}.topbar nav a:hover,.socials a:hover{color:var(--green)}.topbar nav a:hover:before{opacity:1}.top-contact{border:1px solid var(--line);padding:10px 13px;color:var(--green)}.live-dot,.current-tag i{display:inline-block;background:var(--green);width:7px;height:7px;border-radius:50%;margin-right:7px;box-shadow:0 0 11px #b7ff4a99;animation:pulse 2s ease-in-out infinite}.hero{min-height:650px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;position:relative;padding:80px 0 100px;gap:50px}.terminal-line,.eyebrow,.section-label,.hero-meta,.section-kicker,.terminal-card,.skill-number,footer,.current-tag{font-family:var(--mono)}.terminal-line{font-size:11px;color:var(--muted);margin:0 0 29px}.prompt{color:var(--green)}.command{color:var(--cyan)}.eyebrow{font-size:10px;letter-spacing:.1em;color:var(--muted);margin:0 0 22px}.eyebrow span{color:var(--pink);padding:0 5px}.hero h1{font-size:clamp(56px,7vw,91px);line-height:.98;letter-spacing:-.075em;margin:0;font-weight:600}.glitch{color:var(--green);position:relative;text-shadow:0 0 25px #b7ff4a22}.glitch:after{content:attr(data-text);position:absolute;left:2px;top:0;color:var(--pink);opacity:.45;clip-path:inset(65% 0 0);animation:glitch 4s infinite}.hero-intro{font-size:14px;line-height:1.9;color:#9daaa1;max-width:455px;margin:28px 0 32px}.hero-actions{display:flex;align-items:center;gap:25px;flex-wrap:wrap}.button{padding:15px 18px;font:11px var(--mono);display:inline-flex;gap:24px;align-items:center;transition:all .2s}.button-primary{background:var(--green);color:#10160d;box-shadow:0 0 25px #b7ff4a20}.button-primary:hover{box-shadow:0 0 32px #b7ff4a70;transform:translateY(-2px)}.text-link{font:10px var(--mono);color:var(--cyan)}.terminal-card{height:355px;max-width:470px;width:100%;justify-self:end;position:relative;background:linear-gradient(145deg,#101a14,#0a0f0c);border:1px solid #35503b;box-shadow:0 25px 90px #0009,0 0 35px #53ff7620;overflow:hidden;animation:float 6s ease-in-out infinite}.terminal-card:after{content:'';position:absolute;inset:0;background:linear-gradient(115deg,transparent 25%,#b7ff4a08 50%,transparent 75%);transform:translateX(-100%);animation:sweep 7s ease-in-out infinite}.terminal-head{height:43px;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 14px;gap:12px;color:#98a89c;font-size:9px;position:relative;z-index:1}.window-dots{display:flex;gap:5px}.window-dots i{width:7px;height:7px;border-radius:50%;background:#ff5e67}.window-dots i:nth-child(2){background:#ffbd4a}.window-dots i:nth-child(3){background:var(--green)}.terminal-lock{margin-left:auto;color:var(--green);font-size:8px}.terminal-body{padding:22px 25px;position:relative;z-index:1;font-size:11px;color:#d7e2d9}.terminal-body>p{margin:0 0 17px}.terminal-muted{color:#526459;margin-right:12px}.json-block{padding-left:42px;line-height:2;color:#809186}.brace{color:var(--green)}.json-key{color:var(--cyan)}.json-value{color:#e4d888}.indent{padding-left:18px}.terminal-result{margin-top:18px!important}.cursor{color:var(--green);animation:blink 1s steps(2,start) infinite}.terminal-footer{position:absolute;left:25px;right:25px;bottom:18px;padding-top:10px;border-top:1px solid var(--line);display:flex;justify-content:space-between;color:#708177;font-size:8px}.terminal-footer .live-dot{width:5px;height:5px}.terminal-orbit{position:absolute;border:1px solid #b7ff4a12;border-radius:50%;pointer-events:none}.orbit-a{width:190px;height:190px;right:-80px;top:70px}.orbit-b{width:265px;height:265px;right:-118px;top:30px;border-style:dashed;animation:spin 32s linear infinite}.hero-meta{position:absolute;bottom:28px;left:0;right:0;display:flex;justify-content:space-between;color:#65736a;font-size:9px;letter-spacing:.1em}.hero-meta b{color:var(--green);margin-left:9px}.section-grid{display:grid;grid-template-columns:27% 1fr;border-top:1px solid var(--line);padding:100px 0}.section-label{font-size:10px;letter-spacing:.08em;color:#8b9b90;padding-top:7px}.section-label span{color:var(--green);margin-right:12px}.section-kicker{font-size:10px;color:var(--cyan);margin:0 0 19px}.about h2,.skills h2{font-size:clamp(38px,5vw,62px);line-height:1.08;letter-spacing:-.06em;font-weight:500;margin:0}.about h2 span{color:#7e8d83}.about-bottom{display:grid;grid-template-columns:1fr 1fr;gap:35px;margin-top:35px;max-width:730px}.about-bottom p,.role-summary{color:#9ba89f;font-size:13px;line-height:1.9;margin:0}.experience{padding-top:90px;padding-bottom:110px}.experience-heading{display:flex;justify-content:space-between;align-items:flex-start}.experience-heading .eyebrow{font-size:9px;margin:0 0 14px}.experience-heading h2,.education h2{font-size:27px;letter-spacing:-.04em;margin:0 0 8px;font-weight:500}.company{font-size:12px;color:#a1aea5;margin:0}.company span{color:#65736a}.current-tag{padding:9px 11px;border:1px solid var(--line);font-size:8px;color:var(--green)}.current-tag i{width:6px;height:6px;margin-right:5px}.role-summary{margin:26px 0 8px;max-width:580px}.work-list{border-top:1px solid var(--line);margin-top:28px}.work-item{display:grid;grid-template-columns:45px 1fr 25px;gap:15px;padding:26px 0;border-bottom:1px solid var(--line);transition:background .2s,padding .2s}.work-item:hover{background:#b7ff4a08;padding-left:10px;padding-right:10px}.work-index{font:10px var(--mono);color:var(--green);padding-top:4px}.work-item h3{font-size:15px;margin:0 0 10px;letter-spacing:-.02em}.work-item p{max-width:690px;font-size:12px;line-height:1.8;color:#96a49a;margin:5px 0}.work-arrow{font-size:15px;color:var(--pink);transition:transform .2s}.work-item:hover .work-arrow{transform:translate(3px,-3px)}.tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.tags span{font:9px var(--mono);color:#a8b7ac;padding:6px 8px;border:1px solid #293c30;background:#0c130f}.skills{padding-top:90px;padding-bottom:100px}.skills h2{font-size:42px;margin-bottom:30px}.skills-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);border-left:1px solid var(--line)}.skill-card{min-height:140px;padding:22px 24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);position:relative;transition:background .2s}.skill-card:hover{background:#b7ff4a0a}.skill-number{color:var(--green);font-size:9px}.skill-card h3{font-size:14px;margin:17px 0 8px;font-weight:500}.skill-card p{font-size:11px;color:#98a69d;margin:0;line-height:1.7}.education{padding-top:75px;padding-bottom:80px}.education-content{display:flex;justify-content:space-between;align-items:flex-end}.education-content .eyebrow{font-size:9px;margin:0 0 14px}.education h2{font-size:22px}.education-note{font-size:11px;line-height:2;color:#98a69d;margin:0}.contact{position:relative;background:linear-gradient(125deg,#101812,#0c1110);border:1px solid #2b3b30;padding:75px 9%;overflow:hidden}.contact .eyebrow{font-size:9px;color:#a2afa5}.contact h2{font-size:clamp(50px,7vw,82px);line-height:1;letter-spacing:-.07em;font-weight:500;margin:0 0 29px}.contact h2>span{color:var(--green)}.contact-code{position:absolute;right:12%;top:50%;transform:translateY(-50%);font:13px/2 var(--mono);letter-spacing:.25em;color:#b7ff4a1a;animation:flicker 5s linear infinite}footer{min-height:82px;display:flex;align-items:center;justify-content:space-between;color:#748178;font-size:8px;letter-spacing:.05em}footer b{color:var(--pink);margin:0 4px}.socials{display:flex;gap:20px}.socials a{font-size:8px;color:#a3afa6;transition:color .2s}
	@keyframes blink{to{visibility:hidden}}@keyframes pulse{50%{opacity:.45;box-shadow:0 0 3px #b7ff4a55}}@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes sweep{0%,65%{transform:translateX(-100%)}85%,100%{transform:translateX(100%)}}@keyframes glitch{0%,91%,94%,100%{transform:translate(0)}92%{transform:translate(-3px,1px)}93%{transform:translate(3px,-1px)}}@keyframes flicker{0%,95%,98%,100%{opacity:.8}96%,97%{opacity:.2}}
