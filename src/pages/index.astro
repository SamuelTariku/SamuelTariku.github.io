-size:8px}.signal{width:5px;height:5px;margin-right:8px}.hud-contact{padding:11px 14px;border:1px solid #ff315866;color:#ff748b;transition:.25s;box-shadow:inset 0 0 16px #ff315811}.hud-contact span{margin-left:12px}.hud-contact:hover{background:var(--red);color:white;box-shadow:0 0 24px #ff315877}.hero-content{position:absolute;inset:78px 8% 70px;display:flex;align-items:center;justify-content:space-between;gap:30px}.intro-block{transform:perspective(700px) rotateY(7deg);animation:rise-in .9s both}.overline,.micro{font:9px var(--mono);letter-spacing:.16em;color:var(--blue)}.overline{display:flex;align-items:center;gap:11px}.overline i{height:1px;width:34px;background:var(--red);box-shadow:0 0 9px var(--red)}h1{position:relative;margin:14px 0 0;font-size:clamp(85px,15vw,205px);line-height:.82;letter-spacing:-.105em;font-weight:700;color:#e8edff;text-shadow:4px 0 #ff315866,-4px 0 #49b9ff77,0 0 36px #478aff55;}h1:after{content:attr(data-text);position:absolute;inset:0;color:var(--red);opacity:.3;clip-path:inset(60% 0 15%);transform:translateX(7px);}.hero-role{font:12px var(--mono);letter-spacing:.22em;color:#aab8d4;margin:25px 0 0;text-shadow:0 0 15px #49b9ff55}.caret{color:var(--red);}.main-menu{width:min(320px,35vw);min-width:260px;padding:20px 22px 16px;background:linear-gradient(135deg,#09101fdc,#090b17c9);border:1px solid #5674a555;box-shadow:12px 14px 0 #03040bb8,0 0 45px #258cff24,inset 0 0 30px #438fff0c;transform:perspective(800px) rotateY(-8deg) rotateX(2deg);animation:menu-in .8s .2s both;position:relative}.main-menu:before,.main-menu:after{content:'';position:absolute;width:28px;height:28px;border-color:var(--red)}.main-menu:before{left:-1px;top:-1px;border-top:2px solid;border-left:2px solid}.main-menu:after{right:-1px;bottom:-1px;border-bottom:2px solid;border-right:2px solid}.menu-label{display:flex;justify-content:space-between;color:#7182a2;font:8px var(--mono);letter-spacing:.13em;margin:0 0 13px;padding:0 2px 12px;border-bottom:1px solid #31405d}.men