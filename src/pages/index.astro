					<div class="work-list">{projects.map((project, index) => <article class="work-item reveal"><div class="work-title"><span class="work-index">0{index + 1}</span><h3>{project.title}{project.role && <small class="project-role">{project.role}</small>}</h3><span class="mission-status">CLEARED <b>✓</b></span></div><div class="work-detail"><p>{project.description}</p>{index === 0 && <figure class="project-shot"><img src="/images/makerbets-dashboard.png" alt="Maker Bets sports betting dashboard" loading="lazy" decoding="async" /><figcaption><span>◈ MAKER BETS // LIVE INTERFACE</span><span>FIELD CAPTURE 01</span></figcaption></figure>}{project.highlights && <details class="mission-brief"><summary><span>⌘</span> OPEN MISSION INTEL <b>+</b></summary><ul>{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul></details>}<div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></div></article>)}</div>
				</section>

				<section class="content-section loadout reveal" id="skills">
