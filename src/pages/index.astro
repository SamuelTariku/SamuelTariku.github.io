						<p class="hero-role">SOFTWARE ENGINEER<span class="caret">_</span></p>
					</div>
					<nav class="main-menu" aria-label="Explore portfolio">
						<p class="menu-label">SELECT DESTINATION <span>01 — 06</span></p>
						<a href="#about"><span class="menu-index">01</span><span>PROFILE</span><b>↗</b></a>
						<a href="#experience"><span class="menu-index">02</span><span>MISSIONS</span><b>↗</b></a>
						<a href="#skills"><span class="menu-index">03</span><span>LOADOUT</span><b>↗</b></a>
