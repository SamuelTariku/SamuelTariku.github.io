---
const skills = [
	{ title: 'Languages', items: 'Go · TypeScript · Python · SQL · Dart' },
	{ title: 'Frontend', items: 'React · Next.js · Vue.js · Flutter' },
	{ title: 'Backend', items: 'Go / Fiber · Express · Django · Flask' },
	{ title: 'Data & tools', items: 'PostgreSQL · SQLite · MongoDB · Redis · Postman' },
];

const projects = [
	{ title: 'Multi-tenant sports betting platform', description: 'Customer apps, operations dashboards, wallets, and real-time betting systems.', tags: ['Next.js', 'Go / Fiber', 'PostgreSQL', 'Redis'], highlights: ['Tenant isolation, branding, and market configuration', 'Customer sportsbook, live odds, and bet slips', 'Admin dashboards, role-based access, and approval flows', 'Wallets, deposits, withdrawals, and payment integrations', 'WebSockets, notifications, and production support'] },
	{ title: 'Study abroad mobile application', description: 'Flutter app for students applying to universities abroad.', tags: ['Flutter', 'Product collaboration'] },
	{ title: 'Audiobook platform', description: 'Authentication, content management, and audio streaming.', tags: ['Express.js', 'Vue.js', 'Google Cloud'] },
	{ title: 'Supermarket e-commerce', description: 'Admin tools and customer storefront for online shopping.', tags: ['Vue.js', 'E-commerce'] },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Samuel Tariku — software engineer, Addis Ababa." />
		<meta name="theme-color" content="#050711" />
		<title>Samuel Tariku — System Menu</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main>
			<section class="title-screen" id="top" aria-label="Main menu">
				<img class="screen-mark" src="/images/samuel-mark.png" alt="" fetchpriority="high" decoding="async" />
				<div class="screen-grid"></div><div class="screen-noise"></div>
				<header class="hud">
					<a class="identity" href="#top" aria-label="Samuel Tariku home"><span class="status-light"></span> ST<span class="slash">//</span>SYS</a>
					<div class="hud-center"><span class="signal"></span> SECURE CONNECTION</div>
					<a class="hud-contact" href="mailto:samueltarikufantaye@gmail.com">CONTACT <span>↗</span></a>
				</header>
				<div class="hero-content">
					<div class="intro-block">
						<p class="overline"><span>PLAYER 01</span><i></i> ADDIS ABABA, ET</p>
						<h1 data-text="SAMUEL">SAMUEL</h1>
						<p class="hero-role">SOFTWARE ENGINEER<span class="caret">_</span></p>
					</div>
					<nav class="main-menu" aria-label="Explore portfolio">
						<p class="menu-label">SELECT DESTINATION <span>01 — 05</span></p>
						<a href="#about"><span class="menu-index">01</span><span>PROFILE</span><b>↗</b></a>
						<a href="#experience"><span class="menu-index">02</span><span>MISSIONS</span><b>↗</b></a>
						<a href="#skills"><span class="menu-index">03</span><span>LOADOUT</span><b>↗</b></a>
						<a href="#education"><span class="menu-index">04</span><span>ARCHIVE</span><b>↗</b></a>
						<a href="#contact"><span class="menu-index">05</span><span>CONTACT</span><b>↗</b></a>
					</nav>
				</div>
				<div class="screen-footer"><span><i class="status-light"></i> SYSTEM ONLINE</span><span>EST. 09°01' N / 38°45' E</span><a href="#about">PRESS ENTER <b>↓</b></a></div>
				<div class="corner corner-a"></div><div class="corner corner-b"></div>
			</section>

			<div class="content-shell">
				<section class="content-section profile" id="about">
					<div class="section-head"><span>01 / PROFILE</span><span>IDENTITY FILE</span></div>
					<div class="profile-body"><p class="micro">SOFTWARE ENGINEER · ADDIS ABABA</p><h2>Samuel Tariku</h2><p>Full-stack engineer building web and mobile products, from multi-tenant platforms to customer-facing applications.</p></div>
				</section>

				<section class="content-section missions" id="experience">
					<div class="section-head"><span>02 / MISSIONS</span><span>YALTOPIA SOFTWARE TECHNOLOGIES</span></div>
					<div class="role-head"><div><p class="micro">APR 2023 — SEP 2026</p><h2>Lead Frontend Developer</h2></div><span class="role-location">ADDIS ABABA</span></div>
					<div class="work-list">{projects.map((project, index) => <article class="work-item"><div class="work-title"><span class="work-index">0{index + 1}</span><h3>{project.title}</h3><span class="work-cross">↗</span></div><div class="work-detail"><p>{project.description}</p>{index === 0 && <figure class="project-shot"><img src="/images/makerbets-dashboard.png" alt="Maker Bets sports betting dashboard" loading="lazy" decoding="async" /><figcaption>MAKER BETS // LIVE INTERFACE</figcaption></figure>}{project.highlights && <details class="mission-brief"><summary>TECHNICAL DETAILS <span>+</span></summary><ul>{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul></details>}<div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></div></article>)}</div>
				</section>

				<section class="content-section loadout" id="skills">
					<div class="section-head"><span>03 / LOADOUT</span><span>SKILL MODULES</span></div>
					<div class="skills-grid">{skills.map((skill, index) => <article class="skill-card"><span>0{index + 1} //</span><h3>{skill.title}</h3><p>{skill.items}</p></article>)}</div>
				</section>

				<section class="content-section archive" id="education">
					<div class="section-head"><span>04 / ARCHIVE</span><span>EDUCATION</span></div>
					<div class="archive-body"><p class="micro">JAN 2018 — MAR 2023</p><h2>BSc in Information Technology</h2><p>Addis Ababa Institute of Technology</p></div>
				</section>

				<section class="content-section contact" id="contact">
					<div class="section-head"><span>05 / CONTACT</span><span>CHANNEL OPEN</span></div>
					<div class="contact-body"><p class="micro">READY WHEN YOU ARE</p><h2>Start a project.</h2><a class="contact-link" href="mailto:samueltarikufantaye@gmail.com">Samueltarikufantaye@gmail.com <span>↗</span></a></div>
					<div class="socials"><a href="https://www.linkedin.com/in/samuel-tariku-a7a389113/" target="_blank" rel="noreferrer">LINKEDIN ↗</a><a href="https://github.com/SamuelTariku/" target="_blank" rel="noreferrer">GITHUB ↗</a></div>
				</section>
				<footer><a href="#top">ST // RETURN TO MENU ↑</a><span>© 2026 SAMUEL TARIKU</span></footer>
			</div>
		</main>
	</body>
</html>

<style>
	:root{font-family:'Space Grotesk',sans-serif;color:#e8edff;background:#050711;font-synthesis:none;text-rendering:optimizeLegibility;--bg:#050711;--panel:#0a0e1c;--ink:#e8edff;--muted:#8390aa;--line:#26304a;--red:#ff3158;--blue:#49b9ff;--mono:'DM Mono',monospace}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0;background:var(--bg)}a{color:inherit;text-decoration:none}.title-screen{height:100svh;min-height:650px;position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(ellipse at 75% 49%,#10274788,transparent 38%),radial-gradient(ellipse at 14% 72%,#4a101e77,transparent 38%),#050711}.screen-mark{position:absolute;z-index:-3;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:.34}.title-screen:before{content:'';position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,#050711ee 0%,#05071199 34%,#05071133 72%,#0507119c 100%),linear-gradient(0deg,#050711 0%,transparent 20%,transparent 82%,#050711aa 100%)}.screen-grid{position:absolute;inset:-10%;z-index:-1;opacity:.16;background-image:linear-gradient(#49b9ff28 1px,transparent 1px),linear-gradient(90deg,#49b9ff28 1px,transparent 1px);background-size:70px 70px;transform:perspective(650px) rotateX(58deg) scale(1.5);transform-origin:center bottom;mask-image:linear-gradient(transparent,#000 35%)}.screen-noise{pointer-events:none;position:absolute;inset:0;opacity:.18;background:repeating-linear-gradient(0deg,transparent 0 3px,#000 4px 5px)}.hud,.screen-footer{position:absolute;left:5.5%;right:5.5%;display:flex;align-items:center;justify-content:space-between;font:10px var(--mono);letter-spacing:.13em}.hud{top:0;height:78px;border-bottom:1px solid #8092c333}.identity{display:flex;align-items:center;gap:10px;color:var(--ink);font-weight:500}.slash{color:var(--red)}.status-light,.signal{width:7px;height:7px;border-radius:50%;display:inline-block;background:var(--blue);box-shadow:0 0 12px var(--blue)}.hud-center{color:#8192b2;font-size:8px}.signal{width:5px;height:5px;margin-right:8px}.hud-contact{padding:11px 14px;border:1px solid #ff315866;color:#ff748b;transition:.25s;box-shadow:inset 0 0 16px #ff315811}.hud-contact span{margin-left:12px}.hud-contact:hover{background:var(--red);color:white;box-shadow:0 0 24px #ff315877}.hero-content{position:absolute;inset:78px 8% 70px;display:flex;align-items:center;justify-content:space-between;gap:30px}.intro-block{transform:perspective(700px) rotateY(7deg);animation:rise-in .9s both}.overline,.micro{font:9px var(--mono);letter-spacing:.16em;color:var(--blue)}.overline{display:flex;align-items:center;gap:11px}.overline i{height:1px;width:34px;background:var(--red);box-shadow:0 0 9px var(--red)}h1{position:relative;margin:14px 0 0;font-size:clamp(85px,15vw,205px);line-height:.82;letter-spacing:-.105em;font-weight:700;color:#e8edff;text-shadow:4px 0 #ff315866,-4px 0 #49b9ff77,0 0 36px #478aff55;}h1:after{content:attr(data-text);position:absolute;inset:0;color:var(--red);opacity:.3;clip-path:inset(60% 0 15%);transform:translateX(7px);}.hero-role{font:12px var(--mono);letter-spacing:.22em;color:#aab8d4;margin:25px 0 0;text-shadow:0 0 15px #49b9ff55}.caret{color:var(--red);}.main-menu{width:min(320px,35vw);min-width:260px;padding:20px 22px 16px;background:linear-gradient(135deg,#09101fdc,#090b17c9);border:1px solid #5674a555;box-shadow:12px 14px 0 #03040bb8,0 0 45px #258cff24,inset 0 0 30px #438fff0c;transform:perspective(800px) rotateY(-8deg) rotateX(2deg);animation:menu-in .8s .2s both;position:relative}.main-menu:before,.main-menu:after{content:'';position:absolute;width:28px;height:28px;border-color:var(--red)}.main-menu:before{left:-1px;top:-1px;border-top:2px solid;border-left:2px solid}.main-menu:after{right:-1px;bottom:-1px;border-bottom:2px solid;border-right:2px solid}.menu-label{display:flex;justify-content:space-between;color:#7182a2;font:8px var(--mono);letter-spacing:.13em;margin:0 0 13px;padding:0 2px 12px;border-bottom:1px solid #31405d}.menu-label span{color:var(--red)}.main-menu>a{height:52px;display:grid;grid-template-columns:34px 1fr 22px;align-items:center;border-bottom:1px solid #33405a88;font:12px var(--mono);letter-spacing:.18em;color:#dce7fc;position:relative;transition:transform .2s,color .2s,text-shadow .2s,padding .2s}.main-menu>a:before{content:'';position:absolute;inset:4px -8px;background:linear-gradient(90deg,#ff31582b,#48baff18,transparent);opacity:0;transform:skewX(-12deg);transition:.2s}.main-menu>a:hover{color:white;text-shadow:0 0 13px var(--blue);padding-left:9px;transform:translateZ(18px)}.main-menu>a:hover:before{opacity:1}.main-menu>a>*{position:relative}.menu-index{font-size:9px;color:var(--red)}.main-menu b{font-size:16px;color:var(--blue);font-weight:400;opacity:0;transform:translate(-5px,5px);transition:.2s}.main-menu>a:hover b{opacity:1;transform:translate(0)}.screen-footer{bottom:0;height:54px;border-top:1px solid #8092c333;color:#7483a1;font-size:8px}.screen-footer>span:first-child{color:var(--blue)}.screen-footer .status-light{width:5px;height:5px;margin-right:7px}.screen-footer a{color:#9aa8c3}.screen-footer b{color:var(--red);font-size:14px;margin-left:6px}.corner{position:absolute;width:24px;height:24px;border-color:#4a6590;opacity:.7}.corner-a{left:5.5%;bottom:66px;border-left:1px solid;border-bottom:1px solid}.corner-b{right:5.5%;top:88px;border-right:1px solid;border-top:1px solid}.content-shell{max-width:1100px;margin:auto;padding:0 6%}.content-section{position:relative;padding:100px 0;border-bottom:1px solid var(--line);scroll-margin-top:12px}.content-section:before{content:'';position:absolute;top:-1px;left:0;width:70px;height:1px;background:var(--red);box-shadow:0 0 12px var(--red)}.section-head{display:flex;justify-content:space-between;gap:16px;color:#90a3c5;font:9px var(--mono);letter-spacing:.14em;margin-bottom:44px}.section-head span:first-child{color:var(--blue)}.profile-body,.archive-body,.contact-body{margin-left:24%}.profile-body .micro,.archive-body .micro,.contact-body .micro,.role-head .micro{color:var(--red);margin:0 0 13px}.profile-body h2,.archive-body h2,.contact-body h2{font-size:clamp(36px,5vw,62px);letter-spacing:-.07em;font-weight:600;margin:0 0 18px;text-shadow:2px 0 #ff315833,-2px 0 #49b9ff44}.profile-body>p:last-child,.archive-body>p:last-child{max-width:570px;color:#9aa8c1;font-size:15px;line-height:1.8;margin:0}.role-head{margin-left:24%;display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:35px}.role-head h2{font-size:clamp(25px,3vw,36px);letter-spacing:-.05em;margin:0}.role-location{font:9px var(--mono);color:#8292b0;letter-spacing:.1em}.work-list{border-top:1px solid var(--line)}.work-item{padding:24px 0;border-bottom:1px solid var(--line)}.work-title{display:grid;grid-template-columns:42px 1fr 22px;align-items:center}.work-index{font:10px var(--mono);color:var(--red)}.work-title h3{font-size:16px;margin:0;font-weight:500}.work-cross{color:var(--blue)}.work-detail{margin:10px 42px 0}.work-detail>p{color:#9aa8c1;font-size:12px;line-height:1.7;margin:0}.project-shot{margin:18px 0 12px;border:1px solid #395278;box-shadow:0 0 25px #258cff1c;overflow:hidden;transform:perspective(900px) rotateX(1deg)}.project-shot img{display:block;width:100%;max-height:360px;object-fit:cover;object-position:top;transition:filter .3s,transform .5s;filter:saturate(.8) contrast(1.08)}.project-shot:hover img{transform:scale(1.02);filter:saturate(1.12) contrast(1.08)}.project-shot figcaption{padding:9px 12px;background:#080d18;color:var(--blue);font:8px var(--mono);letter-spacing:.12em}.mission-brief{margin-top:14px;border:1px solid #293754;background:#080c17}.mission-brief summary{display:flex;justify-content:space-between;cursor:pointer;padding:11px 12px;color:#9bb2d6;font:9px var(--mono);letter-spacing:.1em;list-style:none}.mission-brief summary::-webkit-details-marker{display:none}.mission-brief summary span{font-size:15px;color:var(--red)}.mission-brief[open] summary span{transform:rotate(45deg)}.mission-brief ul{margin:0;padding:0 25px 14px 34px;color:#a3b2ca;font:10px/1.9 var(--mono)}.mission-brief li::marker{color:var(--blue)}.tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.tags span{padding:5px 8px;border:1px solid #2b405e;background:#0b1220;color:#9fcaff;font:8px var(--mono)}.skills-grid{margin-left:24%;display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);border-left:1px solid var(--line)}.skill-card{padding:22px;min-height:135px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(145deg,#0c1423,#090d18);transition:transform .25s,box-shadow .25s}.skill-card:hover{transform:perspective(500px) translateZ(12px);box-shadow:0 0 25px #258cff24,inset 0 0 22px #ff31580a}.skill-card>span{font:9px var(--mono);color:var(--red)}.skill-card h3{font-size:14px;font-weight:500;margin:14px 0 8px}.skill-card p{font-size:10px;line-height:1.7;color:#9aa8c1;margin:0}.archive-body h2{font-size:clamp(25px,4vw,42px)}.archive-body>p:last-child{font-size:13px}.contact-body h2{margin-bottom:22px}.contact-link{display:inline-flex;align-items:center;gap:24px;padding:14px 17px;border:1px solid #438ac2;color:#b7dfff;font:11px var(--mono);box-shadow:0 0 18px #258cff19;transition:.25s}.contact-link:hover{background:#207ecb;color:white;box-shadow:0 0 30px #258cff66;transform:translateY(-3px)}.contact-link span{color:var(--red);font-size:15px}.socials{display:flex;gap:22px;margin:46px 0 0 24%}.socials a,footer{font:9px var(--mono);letter-spacing:.08em;color:#8c9cba}.socials a:hover,footer a:hover{color:var(--blue);text-shadow:0 0 12px var(--blue)}footer{display:flex;justify-content:space-between;padding:25px 0 35px}
	@keyframes rise-in{from{opacity:0;transform:perspective(700px) rotateY(7deg) translateY(22px)}to{opacity:1;transform:perspective(700px) rotateY(7deg) translateY(0)}}@keyframes menu-in{from{opacity:0;transform:perspective(800px) rotateY(-8deg) rotateX(2deg) translateX(24px)}to{opacity:1;transform:perspective(800px) rotateY(-8deg) rotateX(2deg) translateX(0)}}
	@media(max-width:760px){.title-screen{min-height:720px}.screen-mark{object-fit:contain;transform:scale(1.35);opacity:.24}.hero-content{inset:100px 8% 80px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:42px}.intro-block{margin-left:2px}.main-menu{width:min(100%,430px);min-width:0;align-self:center;transform:none}.hud,.screen-footer{left:6%;right:6%}.hud-center{display:none}.hero-role{margin-top:18px}.corner-a{left:6%}.corner-b{right:6%}.content-section{padding:72px 0}.section-head{margin-bottom:32px;font-size:8px}.profile-body,.archive-body,.contact-body,.role-head,.skills-grid,.socials{margin-left:0}.role-head{align-items:flex-start;gap:15px}.role-location{padding-top:5px}.work-detail{margin-left:32px}.work-title{grid-template-columns:32px 1fr 22px}.skill-card{padding:17px;min-height:130px}footer{font-size:8px}}
	@media(max-width:430px){.title-screen{min-height:700px}.hud{height:66px}.hero-content{inset:86px 7% 70px;gap:36px}h1{font-size:clamp(78px,22vw,112px)}.main-menu{padding:15px 17px 12px}.main-menu>a{height:47px}.screen-footer{font-size:7px;letter-spacing:.06em}.screen-footer>span:nth-child(2){display:none}.content-shell{padding:0 7%}.section-head span:last-child{font-size:7px}.profile-body h2,.contact-body h2{font-size:40px}.work-title h3{font-size:14px}.work-detail{margin-left:0}.skills-grid{grid-template-columns:1fr}.skill-card{min-height:auto}footer{gap:10px;flex-direction:column;align-items:flex-start}}
	@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
</style>
